// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  password      String?   // Hashed password for credentials auth
  accountType   String?   @default("Customer")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isActive      Boolean   @default(true)

  // Relations
  templates Template[]
  sessions  Session[]
  accounts  Account[]

}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  thumbnail   String?
  modelFile   String?
  objData     String?  // Store the raw OBJ text for user-uploaded models
  isPublic    Boolean  @default(false)
  isDefault   Boolean  @default(false)
  slug        String   @unique
  editorState String?
  documentData String? // Base64 content of attached PDF/Docx
  documentName String? // Filename of attached PDF/Docx
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations — optional so system defaults don't require a user
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([isPublic])
  @@index([isDefault])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model ApprovalRequest {
  id            String   @id @default(cuid())
  designName    String
  designSlug    String
  designerName  String
  designerEmail String
  // PENDING (waiting for the Head of Designer) -> APPROVED | REJECTED
  status        String   @default("PENDING")
  remarks       String?  // Head of Designer feedback / rejection comments
  headStatus    String?  // Last review decision: APPROVED | REJECTED (null = not reviewed)
  headRemarks   String?  // Remarks from an earlier two-step review (older designs only)
  headReviewer  String?  // Name of the reviewer
  documentData  String?  // Base64 content of attached PDF/Docx
  documentName  String?  // Filename of attached PDF/Docx
  customerEmail String?  // Specific customer account this design is shared with
  customerStatus  String?  // Customer decision once shared: PENDING | APPROVED | REJECTED
  customerRemarks String?  // Customer feedback
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([designSlug])
  @@index([customerEmail])
  @@index([designerEmail])
}

// Admin-configurable application settings (key/value)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
