# Copy to frontend/.env for local development. On Render these are set on the web service.

# Local development (SQLite file, relative to frontend/prisma/)
DATABASE_URL="file:../dev.db"
# Production: Render sets this automatically from the database (internal connection URL)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Public URL of the site. On Render it defaults to the service URL (RENDER_EXTERNAL_URL);
# set it explicitly when you use a custom domain, e.g. https://mockups.example.com
NEXTAUTH_URL="http://localhost:3000"

# First administrator, created on deploy only if no active administrator exists
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional: Hugging Face API key for AI artwork generation
HF_API_KEY=""
