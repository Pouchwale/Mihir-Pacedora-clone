{
  "name": "pacdora-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev frontend",
    "build": "prisma generate && next build frontend",
    "start": "NEXTAUTH_URL=${NEXTAUTH_URL:-$RENDER_EXTERNAL_URL} next start frontend -p ${PORT:-3000}",
    "db:deploy": "node frontend/scripts/deploy-migrate.js",
    "db:seed": "node frontend/scripts/seed.js",
    "db:copy-local-data": "node frontend/scripts/copy-sqlite-to-postgres.js",
    "db:sqlite-schema": "node frontend/scripts/make-sqlite-schema.js",
    "lint": "next lint frontend"
  },
  "engines": {
    "node": ">=20.18"
  },
  "prisma": {
    "schema": "frontend/prisma/schema.prisma"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.14.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.16.0",
    "next": "14.2.35",
    "next-auth": "4.24.15",
    "openai": "^6.41.0",
    "prisma": "^5.14.0",
    "react": "^18",
    "react-dom": "^18",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.41",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "pg": "^8.23.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
